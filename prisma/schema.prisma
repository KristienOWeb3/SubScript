  @@map("banned_accounts")
}

model BannedIp {
  ip        String    @id @map("ip")
  reason    String?   @map("reason")
  bannedBy  String    @map("banned_by")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("banned_ips")
}

/// Freezes withdrawals for one wallet without banning it — a ban kills every session, so it
/// cannot be used for a payout dispute where the account still has to sign in and answer
/// questions. `scope` is USER (vault withdrawals), MERCHANT (merchant claims), or BOTH,
/// because one address can hold both roles through different endpoints. Never query this
/// directly from a withdrawal path — go through assertWithdrawalAllowed() in
/// @/lib/admin/withdrawalHolds so expiry is applied and the read fails CLOSED.
model WithdrawalHold {
  address   String    @id @map("address")
  scope     String    @default("BOTH") @map("scope")
  reason    String?   @map("reason")
  placedBy  String    @map("placed_by")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@map("withdrawal_holds")
}

/// The delegated admin roster. Root admins are env-configured and never appear here — see
/// @/lib/admin/allowlist for why that tier stays outside the database.
///
/// Columns below `createdAt` were added by
/// supabase/migrations/20260822120000_admin_scoped_roles_and_governance.sql. Never read
/// `scopes` directly: go through scopesForDelegatedAdmin() in @/lib/admin/scopes so the
/// least-privilege floor applies to an empty array, and never read the roster without
/// applying `expiresAt` — isAdminWallet() and mirrorDelegatedAdmins() both filter on it, and
/// a reader that forgets leaves a lapsed grant working.
model AdminWallet {
  wallet    String   @id @map("wallet")
  label     String?  @map("label")
  grantedBy String   @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")
  /// Closed vocabulary, validated only in @/lib/admin/scopes — the column deliberately
  /// carries no CHECK constraint. Empty means least privilege, not no access.
  scopes    String[] @map("scopes")
  /// NULL = permanent, matching BannedAccount and WithdrawalHold.
  expiresAt DateTime? @map("expires_at")
  /// Why this person has console access. Distinct from `label`, which is a display name.
  grantReason String? @map("grant_reason")
  /// True for rows backfilled wide when scoping landed. Informational: the console badges
  /// them so an operator narrows them deliberately rather than discovering it in an incident.
  legacyFullScope Boolean @default(false) @map("legacy_full_scope")

  @@index([expiresAt])
  @@map("admin_wallets")
}

model AdminAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor     String   @map("actor")
  action    String   @map("action")
