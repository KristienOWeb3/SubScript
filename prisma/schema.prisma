  leaseExpiresAt         DateTime? @map("lease_expires_at")
  providerOperationId    String?   @map("provider_operation_id")
  txHash                 String?   @map("tx_hash")
  lastError              String?   @map("last_error")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt            DateTime? @map("completed_at")

  @@unique([merchantAddress, idempotencyKey], map: "subscription_attempts_merchant_key")
  @@index([subscriberAddress], map: "subscription_attempts_subscriber_idx")
  @@index([leaseToken], map: "subscription_attempts_lease_idx")
  @@map("subscription_attempts")
