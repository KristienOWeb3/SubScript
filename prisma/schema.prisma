  totalRecipients Int       @default(0) @map("total_recipients")
  sentCount       Int       @default(0) @map("sent_count")
  failedCount     Int       @default(0) @map("failed_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@map("admin_broadcasts")
}

/// One row per (recipient, announcement) — the notification bell's backing store. See the
/// migration header for why announcements do not go through SubscriptDm and why `audience` is a
/// column rather than something inferred from the wallet. A broadcast to "both" writes two rows
/// for a wallet that is both a customer and a merchant, because each bell is read independently.
model AccountNotification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always lowercase; a check constraint enforces it so a checksummed insert fails loudly.
  recipientAddress String    @map("recipient_address")
  /// "USER" | "MERCHANT" — which dashboard's bell shows this row.
  audience         String    @map("audience")
  title            String    @map("title")
  body             String    @map("body")
  url              String?   @map("url")
  /// "ADMIN" | "SYSTEM".
  source           String    @default("ADMIN") @map("source")
  /// Not a relation: a notification outlives the broadcast it came from, and system rows have none.
  broadcastId      String?   @map("broadcast_id") @db.Uuid
  /// Null means unread. A timestamp rather than a boolean so the read time is preserved.
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([recipientAddress, audience, createdAt(sort: Desc)])
  @@map("account_notifications")
}

