  balanceUsdc      BigInt   @map("balance_usdc")
  note             String?
  requestId        String?  @map("request_id")
  environment      String   @default("TEST")
  // Which shared Commit ID drove this usage line, so the primary sees per-friend spend rather
  // than one undifferentiated total. Null on usage the primary drove through their own address.
  commitId         String?  @map("commit_id")
  createdAt        DateTime @default(now()) @map("created_at")
  vault            MeteredVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([userAddress, createdAt])
  @@index([merchantAddress, createdAt])
  @@index([vaultId, createdAt])
  @@map("metered_usage_reports")
}

