model MeteredVault {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAddress       String   @map("user_address")
  merchantAddress   String   @map("merchant_address")
  balanceUsdc       BigInt   @default(0) @map("balance_usdc")
  thresholdUsdc     BigInt   @default(2000000) @map("threshold_usdc")
  topUpAmountUsdc   BigInt   @default(10000000) @map("top_up_amount_usdc")
  monthlyLimitUsdc  BigInt   @default(50000000) @map("monthly_limit_usdc")
  monthlySpentUsdc  BigInt   @default(0) @map("monthly_spent_usdc")
  lastTopUpAt       DateTime? @map("last_top_up_at")

  // Auto top-up mandate. The user grants it explicitly (autoTopUpEnabled defaults false); the
  // keeper refills the vault unattended while all three bounds hold: the flag, monthlySpentUsdc
  // against monthlyLimitUsdc within the calendar month anchored by monthlyWindowStart, and the
  // real on-chain allowance mirrored in autoTopUpAllowanceUsdc. topUpDueAt is an arming flag set
  // by report-usage and cleared by the keeper — not a schedule.
  // NOTE: the CHECK constraints on these columns live only in SQL (see the auto-topup migration);
  // `prisma migrate dev` / `db push` would silently drop them.
  autoTopUpEnabled       Boolean   @default(false) @map("auto_topup_enabled")
  autoTopUpConsentAt     DateTime? @map("auto_topup_consent_at")
  autoTopUpAllowanceUsdc BigInt    @default(0) @map("auto_topup_allowance_usdc")
  monthlyWindowStart     DateTime? @map("monthly_window_start")
  topUpDueAt             DateTime? @map("topup_due_at")
  autoTopUpFailureCode   String?   @map("auto_topup_failure_code")
  autoTopUpFailedAt      DateTime? @map("auto_topup_failed_at")

  // On-chain escrow mirror (dormant until SubScriptVault is deployed + routes cut over).
  commitUsdc        BigInt   @default(0) @map("commit_usdc")
  owedUsdc          BigInt   @default(0) @map("owed_usdc")
  accruedUsageUsdc  BigInt   @default(0) @map("accrued_usage_usdc")
  // Highest balance-usage threshold (bps) already DM'd this cycle; re-arms when the cycle resets.
  usageNotifiedBps  Int      @default(0) @map("usage_notified_bps")
  cycleStart        DateTime? @map("cycle_start")
  lockedUntil       DateTime? @map("locked_until")
  active            Boolean  @default(false)
  vaultChainId      Int?     @map("vault_chain_id")
  lastSyncedBlock   BigInt?  @map("last_synced_block")
  // Settlement environment isolation: a TEST api key may only touch TEST vaults on Arc testnet.
  environment       String   @default("TEST")
  // Keep the default. It is HALF OF A DB-ENFORCED INVARIANT, not an oversight: the
  // metered_vaults_environment_chain_check constraint requires environment = 'TEST' AND
  // settlement_chain_id = 5042002 together, and settlement_chain_id is part of the vault's
  // UNIQUE identity. Removing it breaks api-key-mode-isolation.test.mjs, which locks this line
  // on purpose. Unlike PaymentLink/PaymentSession, this column is not a stray testnet default.
  settlementChainId BigInt   @default(5042002) @map("settlement_chain_id")
  disputed          Boolean  @default(false)
  // User-initiated cancellation of the metered service. Once set, further usage stops
  // accruing (report-usage refuses new charges), the merchant is notified to stop rendering
  // service, and the user withdraws the unused escrow after lockedUntil. Cleared on re-commit.
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  cancelReason      String?   @map("cancel_reason")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  merchant          Merchant @relation(fields: [merchantAddress], references: [walletAddress], onDelete: Cascade)
  customer          Customer @relation(fields: [userAddress], references: [walletAddress], onDelete: Cascade)
  usageReports      MeteredUsageReport[]
  // Shareable Commit IDs drawing on this escrow: one root plus a capped child per friend.
  commits           UserCommit[]

  @@unique([userAddress, merchantAddress, environment, settlementChainId])
  @@index([userAddress])
  @@index([merchantAddress])
  @@map("metered_vaults")
}

// Append-only ledger of metered usage the merchant reports against a vault. User-visible so the
// running cost is transparent anytime (DigitalOcean-style), and the evidence base for reports.
model MeteredUsageReport {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vaultId          String   @map("vault_id") @db.Uuid
  userAddress      String   @map("user_address")
