# =============================================================================
# SubScript Protocol — Local Environment Configuration Template (.env.local)
# =============================================================================
# SECURITY WARNING: DO NOT COMMIT .env.local OR ANY SENSITIVE SECRETS TO GIT.
#
# Instructions:
#   1. Copy this template to .env.local:
#        cp .env.local.example .env.local
#   2. Fill in local development credentials or sandbox API keys.
#   3. For mainnet staging or dry-run validation, refer to docs/mainnet/README.md Section 6.
#
# =============================================================================
# 1. Network & RPC Configuration
# =============================================================================
# Network mode: "testnet" (Arc Testnet 5042002) or "mainnet" (Arc Mainnet 5042001)
# Note: In "mainnet" mode, the network registry fails closed unless all 12 required variables are set.
NEXT_PUBLIC_ENVIRONMENT=testnet

# Arc EVM JSON-RPC endpoint. Server modules read process.env.ARC_RPC_PRIMARY || process.env.RPC_URL.
RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_PRIMARY=https://rpc.testnet.arc.network

# Client-side RPC endpoint used by wagmi / viem in the browser (must start with https://)
NEXT_PUBLIC_ARC_RPC_PRIMARY=https://rpc.testnet.arc.network

# Network-specific Arc deposit watcher RPC endpoints
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Canonical public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# 2. Smart Contract Addresses
# =============================================================================
# SubScriptRouter UUPS Proxy
NEXT_PUBLIC_SUBSCRIPT_ROUTER_ADDRESS=0x6946B7746c2968B195BD15319D25F67E587CAe3C

# SubScriptPSA (Standard Subscription Engine)
NEXT_PUBLIC_STANDARD_CONTRACT_ADDRESS=0x6C574a62F174b7Dc29060200Ab22afc9933FD502

# SubScriptConfidential (Viewing Keys & Encrypted Payroll Ledger)
NEXT_PUBLIC_CONFIDENTIAL_CONTRACT_ADDRESS=0x835be26e1fa028f86f78a7d1872df0d9f4a56903

# SubScriptVault UUPS Escrow Proxy
NEXT_PUBLIC_SUBSCRIPT_VAULT_ADDRESS=0x853581e119dDED32DB886a4533A11789cF60bBFc
NEXT_PUBLIC_SUBSCRIPT_VAULT_CHAIN_ID=5042002

# Premium merchant registration recipient address
NEXT_PUBLIC_PREMIUM_PAYMENT_RECIPIENT_ADDRESS=0x59D67d7c67ECe389eB4c6EcC0fe66f44391694fA

# Arc Native Memo / Receipts Contract
NEXT_PUBLIC_ARC_MEMO_CONTRACT_ADDRESS=0x5294E9927c3306DcBaDb03fe70b92e01cCede505

# Circle CCTP MessageTransmitterV2 on Arc
NEXT_PUBLIC_ARC_MESSAGE_TRANSMITTER_ADDRESS=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# USDC ERC-20 / Native Gas Token Address on Arc
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Multi-Sig Owner & Treasury
# On Mainnet: Cold Gnosis Safe multi-sig addresses
MULTISIG_ADDRESS=0x[GNOSIS_SAFE_MULTISIG_ADDRESS]
TREASURY_ADDRESS=0x[TREASURY_SAFE_ADDRESS]

# =============================================================================
# 3. Database Secrets (Supabase Postgres)
# =============================================================================
# Transaction Pooler URI on port 6543 (?pgbouncer=true) for runtime application queries
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true # [DO NOT COMMIT - SENSITIVE SECRET]

# Direct Connection URI on port 5432 (bypasses pgbouncer; required for Prisma migrations)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:5432/postgres # [DO NOT COMMIT - SENSITIVE SECRET]

# Supabase API URL and Service Role Key (with full administrative privileges)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]

# =============================================================================
# 4. Circle Developer-Controlled Wallets (MPC Custody)
# =============================================================================
# Circle Developer API Key (sandbox: TEST_API_KEY:..., mainnet: LIVE_API_KEY:...)
CIRCLE_API_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]

# 32-byte hexadecimal entity secret registered with Circle Developer Console
CIRCLE_ENTITY_SECRET= # [DO NOT COMMIT - SENSITIVE SECRET]

# Developer-Controlled Wallet Set ID (all user embedded wallets are generated in this set)
CIRCLE_WALLET_SET_ID= # [WALLET-SET-UUID]
CIRCLE_ARC_WALLET_SET_ID= # Alias for CIRCLE_WALLET_SET_ID

# Wallet account type: "SCA" (enables Gas Station sponsored USDC gas on Arc) or "EOA"
CIRCLE_WALLET_ACCOUNT_TYPE=SCA

# Circle blockchain identifier: "ARC" for mainnet, "ARC-TESTNET" for testnet
CIRCLE_ARC_BLOCKCHAIN=ARC-TESTNET

# Wallet custody provider: "circle" enables Circle MPC wallets; unset uses legacy AES
WALLET_PROVIDER=circle

# =============================================================================
# 5. Cron, Keeper & Webhook Authentication
# =============================================================================
# Vercel Cron bearer token (sent in Authorization: Bearer ${CRON_SECRET})
CRON_SECRET= # [DO NOT COMMIT - SENSITIVE SECRET]

# Internal & GitHub Actions keeper authentication secret
KEEPER_SECRET= # [DO NOT COMMIT - SENSITIVE SECRET]

# Master secret for HMAC-SHA256 signing of outbound merchant webhooks (whsec_[64-char-hex])
SUBSCRIPT_WEBHOOK_SECRET= # [DO NOT COMMIT - SENSITIVE SECRET]

# Signs wallet-bound session cookies and encrypts merchant secrets (64-character hex)
JWT_SECRET= # [DO NOT COMMIT - SENSITIVE SECRET]

# Protects internal admin and KYC endpoints
ADMIN_API_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]

# =============================================================================
# 6. Hot Wallets & Keepers (Signs Transactions & Pays Gas)
# =============================================================================
# Admin Keeper Hot Wallet Key (signs executePayment renewals and payroll sweeps)
PRIVATE_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]

# Vault Settlement Drawer Keeper Key (authorized via setAuthorizedDrawer on SubScriptVault)
KEEPER_PRIVATE_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]

# Gas Sponsorship Hot Wallet Key (subsidizes gas for legacy/embedded user transactions)
SPONSOR_PRIVATE_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]
SPONSOR_GAS_TOPUP_USDC=0.10
SPONSOR_WALLET_DAILY_LIMIT=10
SPONSOR_ACTION_DAILY_LIMIT=5
SPONSOR_GLOBAL_DAILY_BUDGET_USDC=50
SPONSOR_LOW_TOPUPS_THRESHOLD=100
SPONSOR_EMERGENCY_STOP=

# Solana CCTP Relayer Hot Wallet (Arc-to-Solana CCTP V2 withdrawals)
SOLANA_RELAYER_PUBLIC_KEY=GSJ729WXUt7bWGo92ZrfJu5yB6XJYkoG21NFGZM7HPLg
SOLANA_RELAYER_PRIVATE_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# 7. Infrastructure, Email & Telemetry Services
# =============================================================================
# Upstash Redis for distributed sliding-window rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN= # [DO NOT COMMIT - SENSITIVE SECRET]

# Resend API for transactional email receipts and notifications
RESEND_API_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]
EMAIL_FROM=SubScript <support@subscriptonarc.com>
EMAIL_FROM_RECEIPTS=SubScript Receipts <receipts@subscriptonarc.com>
EMAIL_FROM_SECURITY=SubScript Security <auth@subscriptonarc.com>
EMAIL_FROM_OPS=SubScript Ops <ops@subscriptonarc.com>
EMAIL_FROM_LIFECYCLE=SubScript <notifications@subscriptonarc.com>

# Sentry Error & Performance Observability
SENTRY_DSN=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:security@subscriptonarc.com

# =============================================================================
# 8. Admin SIWE & Anti-Bot Protection
# =============================================================================
# Comma-separated hardware wallet allowlist for /admin Sign-In with Ethereum
ADMIN_WALLET_ADDRESSES=0x[HARDWARE_WALLET_1],0x[HARDWARE_WALLET_2]

# Cloudflare Turnstile CAPTCHA keys
TURNSTILE_SECRET_KEY= # [DO NOT COMMIT - SENSITIVE SECRET]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
