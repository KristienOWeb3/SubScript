NEXT_PUBLIC_APP_URL=https://www.subscriptonarc.com

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SEO verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Rate limiting and IP bans
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BANNED_IPS=

# Email
RESEND_API_KEY=
EMAIL_FROM=SubScript <support@subscriptonarc.com>

# API integration testing
SUBSCRIPT_API_KEY=your_api_key_here

# Web Push notifications (generate with: npx web-push generate-vapid-keys)
# The public key must also be exposed to the browser via the NEXT_PUBLIC_ copy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@subscriptonarc.com

# --- Server secrets (required in production; never commit real values) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUBSCRIPT_WEBHOOK_SECRET=
# Signs SubScript's wallet-bound session cookie. Use a long random value.
JWT_SECRET=
# Protects server-only KYC review APIs. Never expose this value to browser code.
ADMIN_API_KEY=
# Comma-separated wallets allowed to reach /admin. Empty means nobody: the middleware gate
# fails closed, so a deploy that omits this locks the console rather than opening it.
ADMIN_WALLET_ADDRESSES=
# --- KYC / KYB provider control plane ---
# Display/adapter identifier stored with new verification cases.
KYC_PROVIDER_NAME=manual
# Optional hosted provider portal. Returned only to an authenticated applicant after case creation.
KYC_PROVIDER_PORTAL_URL=
# Version shown in the applicant consent record.
KYC_CONSENT_VERSION=2026-07-04
# Comma-separated provider-supported ISO 3166-1 alpha-2 jurisdictions.
KYC_SUPPORTED_COUNTRIES=NG
# Cloudflare Turnstile (bot check on signup). BOTH are REQUIRED — verification fails CLOSED, so if
# TURNSTILE_SECRET_KEY is unset every captcha-gated signup is rejected (and the widget won't render
# without the public site key). Create a widget at Cloudflare → Turnstile to get both keys.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Keeper / cron auth. The customer-renewal cron (/api/cron/customer-billing) accepts either.
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET}, so CRON_SECRET must be set for it to run.
KEEPER_SECRET=
CRON_SECRET=
# Admin wallet that signs on-chain keeper txs (executePayment, tier changes) and pays their gas.
PRIVATE_KEY=
# REQUIRED for Merchant-User actions. SubScript sponsors gas: a funded EOA just-in-time tops up
# the user's embedded wallet so gas never eats their payment principal. If this is unset (or the
# wallet is empty), subscribe / cancel / change-plan / vault-commit / execute-tx all FAIL CLOSED
# with "Gas sponsorship unavailable". Set it to a funded Arc EOA (testnet USDC for gas on testnet).
SPONSOR_PRIVATE_KEY=
# Gas TARGET per sponsored action (default 0.10): only the wallet's bounded deficit up to this
# amount is transferred, never a fixed sum, and the payer's declared principal is never counted
# as available gas. Circle SCA wallets are covered by Circle Gas Station and get NO transfer.
SPONSOR_GAS_TOPUP_USDC=0.10
# Durable abuse limits enforced inside the sponsored_gas_operations claim (per rolling day):
SPONSOR_WALLET_DAILY_LIMIT=10
SPONSOR_ACTION_DAILY_LIMIT=5
SPONSOR_GLOBAL_DAILY_BUDGET_USDC=50
# Emergency circuit breaker: "true" refuses every sponsorship immediately.
SPONSOR_EMERGENCY_STOP=
# Sponsor-wallet alerting, driven by GET /api/internal/sponsor-health (see docs/external-crons.md).
# Both have working defaults, so leaving them blank changes nothing.
# Warn while there's still lead time: alert once estimated top-ups remaining falls below this.
# The built-in `underfunded` flag only trips at 2 top-ups left, which is already an outage.
SPONSOR_LOW_TOPUPS_THRESHOLD=100
# How long before a still-unresolved sponsor alert is re-sent (default 360 = 6h).
SPONSOR_ALERT_COOLDOWN_MINUTES=360
# --- Server-side RPC ---
# WARNING: ARC_RPC_PRIMARY WINS over RPC_URL. Roughly a dozen server modules read
# `process.env.ARC_RPC_PRIMARY || process.env.RPC_URL || <testnet default>` (src/lib/payments/rpc.ts,
# src/lib/vault/onchain.ts, src/lib/subscriptions/onchain.ts, src/lib/contracts/health.ts,
# scripts/check-contracts.mjs, ...). If ARC_RPC_PRIMARY is set in Vercel and you only change
# RPC_URL at cutover, every server route keeps talking to TESTNET while the browser talks to
# mainnet. Change BOTH, or unset ARC_RPC_PRIMARY.
# NOTE: Arc's canonical RPC hosts moved to *.arc.io (https://rpc.testnet.arc.io). The
# rpc.*.arc.network hosts below are what this repo has always used; re-point when convenient.
RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_PRIMARY=
# Optional read-only failover chain, tried in order after the primary (src/lib/payments/rpc.ts).
ARC_RPC_SECONDARY=
RPC_FALLBACK_URL_1=
RPC_FALLBACK_URL_2=
# Used ONLY by the Arc USDC deposit watcher (src/lib/deposits/arcDeposits.ts), which picks by
# network instead of reading RPC_URL. Set the mainnet one at cutover or deposit scanning stays
# on testnet even after everything else moves.
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=
# Websocket RPC for the Kafka/event consumer. Defaults to wss://ws.testnet.arc.network.
WS_RPC_URL=

# Platform treasury. Read only by the mainnet readiness gate (validateMainnetConfiguration), so
# it is a required deploy-config assertion rather than a runtime dependency. On mainnet this
# should be the multisig, matching the on-chain Router/Vault treasury.
TREASURY_ADDRESS=

# --- Network selection: leave as testnet, or set to "mainnet" to go live ---
# Mainnet is FAIL-CLOSED: with NEXT_PUBLIC_ENVIRONMENT=mainnet, financial routes refuse to serve
# until EVERY value below is explicitly set (contracts, vault + its chain id, premium recipient,
# USDC, RPC, TREASURY_ADDRESS, CIRCLE_ARC_BLOCKCHAIN=ARC). Testnet defaults are never silently
# used in mainnet mode — see src/lib/network/registry.ts (assertFinancialNetworkReady).
# The full paste-ready cutover list is at the BOTTOM of this file.
NEXT_PUBLIC_ENVIRONMENT=testnet
# Client RPC (wagmi/viem). Set to the mainnet RPC when NEXT_PUBLIC_ENVIRONMENT=mainnet.
NEXT_PUBLIC_ARC_RPC_PRIMARY=

# --- Contract addresses: defaults are Arc TESTNET. Set these to your MAINNET addresses to go live ---
NEXT_PUBLIC_SUBSCRIPT_ROUTER_ADDRESS=
NEXT_PUBLIC_STANDARD_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONFIDENTIAL_CONTRACT_ADDRESS=
NEXT_PUBLIC_PREMIUM_PAYMENT_RECIPIENT_ADDRESS=
NEXT_PUBLIC_ARC_MEMO_CONTRACT_ADDRESS=
NEXT_PUBLIC_ARC_MESSAGE_TRANSMITTER_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# SubScriptVault escrow proxy + its chain id (mainnet mode requires both explicitly).
NEXT_PUBLIC_SUBSCRIPT_VAULT_ADDRESS=
NEXT_PUBLIC_SUBSCRIPT_VAULT_CHAIN_ID=

# --- Circle developer-controlled (MPC) wallets — Phase 1 custody migration ---
# Custodial embedded wallets are moving from a single-AES-key model to Circle MPC custody.
# Provision in the Circle Console (sandbox first): enable Developer-Controlled Wallets on the API
# key, then generate + register an entity secret. Store CIRCLE_ENTITY_SECRET in a secret manager.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Run createArcWalletSet() once, then paste the returned id here (all wallets are created in it).
CIRCLE_ARC_WALLET_SET_ID=
# "SCA" (default — enables Gas Station sponsored USDC gas on Arc) or "EOA".
CIRCLE_WALLET_ACCOUNT_TYPE=SCA
# Arc blockchain id as Circle names it (mainnet: ARC).
CIRCLE_ARC_BLOCKCHAIN=ARC-TESTNET
# Cutover flag: set to "circle" so NEW embedded wallets are provisioned as Circle MPC wallets
# (requires the CIRCLE_* vars above). Unset/anything else = legacy AES-key wallets. Existing
# wallets are unaffected either way. Test on a preview before enabling in production.
WALLET_PROVIDER=


# =============================================================================
# MAINNET CUTOVER LIST — fill in, push to Vercel, delete the testnet values above
# =============================================================================
#
# Every line below is commented out ON PURPOSE. This file gets copied over `.env`, and a
# live-looking empty `NEXT_PUBLIC_SUBSCRIPT_ROUTER_ADDRESS=` would blank a working testnet
# address and silently fall back to an ABANDONED contract. Uncomment at cutover, not before.
#
# READ FIRST: as of 2026-08-24 Arc publishes NO mainnet parameters. Its own docs say
# "Mainnet addresses are not yet available" and list only testnet (chain 5042002).
# So the mainnet values this repo compiles in are GUESSES:
#     ARC_MAINNET_CHAIN_ID = 5042001            (unpublished)
#     https://rpc.mainnet.arc.network            (unpublished; Arc's hosts moved to *.arc.io)
#     ARC_CCTP_DOMAIN_ID = 26                    (source comment says "TBD_MAINNET_DOMAIN")
#     USDC 0x3600...0000                         (testnet value)
# Verify each against docs.arc.io before you trust it. Watch https://status.arc.io.
#
# ORDER OF OPERATIONS
#   1. Deploy the CURRENT contract source to Arc mainnet (not fresh copies of old testnet
#      bytecode — the 2026-07-08 hardening lives only in source until deployed).
#   2. Transfer ownership to the multisig. Rehearse pause/unpause + UUPS upgrade first.
#   3. Fill in this block.
#   4. Push to Vercel Production. DELETE each key first, then import — a Vercel `.env`
#      import SILENTLY SKIPS keys that already exist, so an in-place import is not a change.
#   5. Redeploy. Env only takes effect on the next deploy.
#   6. Run the DB migrations in the "NOT env vars" section below.
#   7. `npm run check:contracts`, then one real small-amount payment end to end.
#   Rollback: unset NEXT_PUBLIC_ENVIRONMENT and the address overrides. All defaults are testnet.
#
# -----------------------------------------------------------------------------
# 1. Flip the network
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENVIRONMENT=mainnet
# NEXT_PUBLIC_SUBSCRIPT_VAULT_CHAIN_ID=5042001        # VERIFY — gate rejects anything else
#
# -----------------------------------------------------------------------------
# 2. RPC — set ALL of these together
# -----------------------------------------------------------------------------
# ARC_RPC_PRIMARY takes precedence over RPC_URL in every server module. Changing only
# RPC_URL leaves the whole backend on testnet while the browser moves to mainnet.
# RPC_URL=                                            # VERIFY host
# ARC_RPC_PRIMARY=                                    # same value, or unset it entirely
# NEXT_PUBLIC_ARC_RPC_PRIMARY=                        # client; must be https:// or gate fails
# ARC_MAINNET_RPC_URL=                                # Arc USDC deposit watcher reads only this
# ARC_RPC_SECONDARY=                                  # optional failover
# RPC_FALLBACK_URL_1=
# RPC_FALLBACK_URL_2=
# WS_RPC_URL=                                         # event consumer; defaults to testnet wss
#
# -----------------------------------------------------------------------------
# 3. Contract addresses — client. These 8 + the vault chain id are FAIL-CLOSED:
#    financial routes throw until all are set and well-formed.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUBSCRIPT_ROUTER_ADDRESS=
# NEXT_PUBLIC_STANDARD_CONTRACT_ADDRESS=
# NEXT_PUBLIC_CONFIDENTIAL_CONTRACT_ADDRESS=
# NEXT_PUBLIC_SUBSCRIPT_VAULT_ADDRESS=
# NEXT_PUBLIC_PREMIUM_PAYMENT_RECIPIENT_ADDRESS=
# NEXT_PUBLIC_ARC_MEMO_CONTRACT_ADDRESS=
# NEXT_PUBLIC_ARC_MESSAGE_TRANSMITTER_ADDRESS=
# NEXT_PUBLIC_USDC_ADDRESS=                           # VERIFY — testnet default is 0x3600...
# TREASURY_ADDRESS=                                   # the multisig
#
# NOT fail-closed, but still wrong on mainnet if you skip it: the memo/receipts contract
# falls back to a TESTNET address in mainnet mode because it is missing from
# MAINNET_REQUIRED_ENV in src/lib/network/registry.ts. Set it, and fix that list.
# NEXT_PUBLIC_ARC_MEMO_CONTRACT_ADDRESS=
#
# Confidential viewing keys (src/lib/arc/memo.ts). Rotate for mainnet.
# PLATFORM_MASTER_VIEW_KEY=
# NEXT_PUBLIC_PLATFORM_VIEW_KEY=
#
# -----------------------------------------------------------------------------
# 4. Contract addresses — server mirrors. NOT read by the app; read by bin/sue.js,
#    scripts/check-contracts.mjs and the deploy scripts. Keep in sync or ops tooling
#    reports on the wrong contracts.
# -----------------------------------------------------------------------------
# SUBSCRIPT_ROUTER_ADDRESS=
# STANDARD_CONTRACT_ADDRESS=
# SUBSCRIPT_VAULT_ADDRESS=
# USDC_ADDRESS=
# STABLEFX_ROUTER_ADDRESS=                            # see the warning in section 8
#
# -----------------------------------------------------------------------------
# 5. Circle — production entity, NOT sandbox
# -----------------------------------------------------------------------------
# A production Circle account is a separate entity: new API key, new entity secret (keep the
# recovery file), and a NEW wallet set. Sandbox wallets DO NOT migrate — every embedded wallet
# that exists today is testnet-only. Decide what you tell those users before you flip this.
# CIRCLE_API_KEY=                                     # live key, not TEST_API_KEY:
# CIRCLE_ENTITY_SECRET=                               # regenerated + registered for production
# CIRCLE_ARC_WALLET_SET_ID=                           # createArcWalletSet() once on production
# CIRCLE_ARC_BLOCKCHAIN=ARC                           # gate rejects anything but "ARC"
# CIRCLE_WALLET_ACCOUNT_TYPE=SCA                      # SCA keeps Gas Station sponsorship
# WALLET_PROVIDER=circle
# CIRCLE_APP_ID=                                      # + NEXT_PUBLIC_CIRCLE_APP_ID for social login
# NEXT_PUBLIC_CIRCLE_GOOGLE_ENABLED=
# CIRCLE_GOOGLE_REDIRECT_URI=
#
# -----------------------------------------------------------------------------
# 6. Wallets that now spend REAL money
# -----------------------------------------------------------------------------
# Gas on Arc is USDC. On mainnet every top-up is a real cost, so the budget caps stop being
# theoretical. Fund these on mainnet and confirm the addresses are the rotated/secure keys.
# PRIVATE_KEY=                                        # keeper signer; pays keeper gas
# KEEPER_PRIVATE_KEY=                                 # vault-draw signer (falls back to PRIVATE_KEY paths)
# SPONSOR_PRIVATE_KEY=                                # gas sponsorship; has been unfunded in prod before
# SPONSOR_GAS_TOPUP_USDC=                             # re-tune for real USDC
# SPONSOR_WALLET_DAILY_LIMIT=
# SPONSOR_ACTION_DAILY_LIMIT=
# SPONSOR_GLOBAL_DAILY_BUDGET_USDC=                   # this is now a real spend ceiling
# SPONSOR_LOW_TOPUPS_THRESHOLD=
# SPONSOR_EMERGENCY_STOP=                             # "true" kills all sponsorship instantly
#
# -----------------------------------------------------------------------------
# 7. Secrets to rotate at cutover (do not carry testnet values into mainnet)
# -----------------------------------------------------------------------------
# JWT_SECRET=            # also the master key for webhook-secret decryption — rotating it
#                        # orphans existing merchant webhook secrets. Plan the re-issue.
# KEEPER_SECRET=
# CRON_SECRET=
# SUBSCRIPT_WEBHOOK_SECRET=
# ADMIN_API_KEY=
# APP_SECRET=
# OTP_SECRET=
# DM_INVITE_SECRET=
# RECEIPT_INDEXER_SECRET=
# CLI_CONFIG_SIGNING_KEY=
# ADMIN_WALLET_ADDRESSES=                             # env-only root tier, unrevocable at runtime
# WALLET_ENCRYPTION_KEY=                              # legacy AES path — should be ABSENT on mainnet
#
# -----------------------------------------------------------------------------
# 8. Deploy-time only — scripts read these, Vercel never needs them
# -----------------------------------------------------------------------------
# CONTRACT_OWNER_ADDRESS=
# VAULT_OWNER_ADDRESS=
# KEEPER_ADDRESS=
# MULTISIG_ADDRESS=                                   # final owner of Router + Vault
#
# WARNING — SubScriptPSA.stableFXRouter is `immutable`. Today it points at a MOCK, and Arc
# publishes no StableFX router (only FxEscrow + Permit2, per docs.arc.io). Getting this wrong
# means a full PSA redeploy, and a PSA redeploy restarts subscription ids at 1. Decide before
# you deploy, not after.
#
# -----------------------------------------------------------------------------
# NOT env vars — but they break mainnet if you skip them
# -----------------------------------------------------------------------------
# * prisma/schema.prisma has THREE columns defaulting to chain 5042002
#   (settlement_chain_id x2, chain_id). Ship a migration or verify the money path writes
#   the mainnet chain id explicitly on every insert.
# * subscriptions.contract_address has a DEFAULT pinned to the testnet PSA. A mainnet PSA
#   needs a migration for that DEFAULT in the same change, plus a re-run of
#   src/lib/subscriptions/__tests__/keeper-contract-scoping.test.mjs and a sweep for
#   unscoped keeper call sites.
# * subscription_billing_claims is still keyed on subscription_id alone, so two PSA
#   generations sharing an id contend for one claim row.
# * RLS is still disabled on fiat_funding_intents / fiat_funding_events.
# * CCTP mainnet config is unsound: src/lib/contracts/constants.ts maps mainnet to the
#   Ethereum CCTP V1 TokenMessenger, but Arc is V2-only (TokenMessengerV2
#   0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA). ARC_MESSAGE_TRANSMITTER_ADDRESS is also
#   hardcoded to testnet with no env override at all.
# * Crons: only customer-billing + vault-draw are in vercel.json (Hobby allows 2 daily).
#   reconcile, billing, payroll, kyc-expiry and reminders run from
#   .github/workflows/keepers.yml — confirm those fire against mainnet before real money.


# =============================================================================
# NGN BANK-TRANSFER FIAT ONRAMP — nothing reads these yet
# =============================================================================
# Current state: /api/user/funding-intents returns 503 FIAT_ONRAMP_UNAVAILABLE for both GET
# and POST. No provider adapter exists, so setting the keys below changes NOTHING today.
# They are listed so the shape is agreed before a provider is picked. Full policy and the
# activation gates live in docs/bank-transfer-usdc-onramp.md.
#
# There is deliberately no flag that turns on fiat funding without a licensed live adapter.
# Bank-transfer-first by design: no card rail, because a card onramp recreates exactly the
# access problem SubScript exists to remove.
#
# BEFORE any of this is legal to switch on (all of it, not most of it):
#   - Arc mainnet live, with verified chain/RPC/USDC/CCTP config.
#   - A licensed VASP/bank partner under contract. Nigeria: SEC-registered (ARIP), with a
#     CBN-designated VASP banking relationship. An ordinary product account is not a lawful
#     crypto collection rail.
#   - That contract assigns KYC/AML, sanctions + PEP screening, sender-name matching,
#     transaction limits, pricing, refunds, disputes, and record retention to a named party.
#   - Signed provider webhooks (raw-body HMAC, replay window, unique event ids) plus a
#     recovery poller for missed or out-of-order events.
#   - Completion gated on independent on-chain receipt verification: chain, token, recipient,
#     amount, tx success, finality. Never mark funded off a provider event alone.
#   - Checkout discloses rate, fee breakdown, exact net USDC, quote expiry, transfer expiry.
#   - Treasury/provider gas reserves monitored; settlement gas is an operating cost and is
#     never deducted from the user's quoted USDC principal.
#
# Expected shape once an adapter exists (names not final — no code depends on them):
# FIAT_ONRAMP_PROVIDER=                   # adapter id, e.g. "quidax"; unset = disabled
# FIAT_ONRAMP_API_BASE_URL=
# FIAT_ONRAMP_API_KEY=
# FIAT_ONRAMP_API_SECRET=
# FIAT_ONRAMP_WEBHOOK_SECRET=             # raw-body HMAC verification
# FIAT_ONRAMP_SETTLEMENT_WALLET=          # where the partner delivers USDC on Arc
# FIAT_ONRAMP_QUOTE_TTL_SECONDS=
# FIAT_ONRAMP_TRANSFER_TTL_SECONDS=
# FIAT_ONRAMP_MIN_NGN=                    # integer kobo
# FIAT_ONRAMP_MAX_NGN=                    # integer kobo
# FIAT_ONRAMP_DAILY_LIMIT_NGN=            # per wallet, integer kobo
# FIAT_ONRAMP_FEE_BPS=
# FIAT_ONRAMP_SUPPORTED_COUNTRIES=NG
# FIAT_ONRAMP_MIN_CONFIRMATIONS=          # finality before marking an intent complete
#
# Matching KYC work, since fiat funding is what makes these load-bearing:
# KYC_PROVIDER_NAME=                      # today "manual" — a real provider id at launch
# KYC_PROVIDER_PORTAL_URL=
# KYC_PROVIDER_API_KEY=                   # no provider integration exists yet
# KYC_PROVIDER_WEBHOOK_SECRET=            # signed status callbacks, not manual review
# KYC_SUPPORTED_COUNTRIES=NG
# KYC_CONSENT_VERSION=
